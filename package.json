{
  "name": "trade-timemachine",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "한국형 타임머신 시뮬레이터 - 1만 번 모의 재생 + 실시간 종목 검색 (투자 권유 아님)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/trade-timemachine/",
    "preview": "vite preview --port 4180 --strictPort",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "samples": "python3 scripts/fetch_samples.py",
    "test:api": "deno test --allow-net --allow-read supabase/functions/stock-bars/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
